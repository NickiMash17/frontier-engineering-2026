{
  "type": "object",
  "required": [
    "cve",
    "package",
    "installed_version",
    "vulnerable_symbol",
    "usage_sites",
    "reachable_path",
    "required_conditions",
    "attacker_controlled_input",
    "verdict",
    "confidence",
    "evidence",
    "uncertainties"
  ],
  "properties": {
    "cve": { "type": "string" },
    "package": { "type": "string" },
    "installed_version": { "type": "string" },
    "vulnerable_symbol": { "type": "string" },
    "usage_sites": { "type": "array", "items": { "type": "string" } },
    "reachable_path": { "type": "array", "items": { "type": "string" } },
    "required_conditions": { "type": "array", "items": { "type": "string" } },
    "attacker_controlled_input": { "type": "boolean" },
    "verdict": {
      "type": "string",
      "enum": ["REACHABLE", "NOT_REACHABLE", "CONDITION_NOT_SATISFIED", "UNCERTAIN"]
    },
    "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
    "evidence": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["file", "lines", "detail"],
        "properties": {
          "type": {
            "type": "string",
            "enum": ["file", "search"],
            "description": "Evidence category. 'file' (default if omitted): a specific file+line location. 'search': a search method (e.g. a repo-wide grep) that supports a negative/absence claim rather than one location -- put the search description in 'file' and 'detail', and 'n/a' in 'lines'."
          },
          "file": { "type": "string" },
          "lines": { "type": "string" },
          "detail": { "type": "string" }
        },
        "additionalProperties": false
      }
    },
    "uncertainties": { "type": "array", "items": { "type": "string" } }
  },
  "additionalProperties": false
}
